{
  "status": "runnable",
  "experiment": {
    "version": "UnifiedRawSOH/Paper-v2",
    "label_mode": "bol_peak_relative",
    "soh_label_mode": "bol_peak_relative",
    "output_root": "UnifiedRawSOH/outputs",
    "loader": "single_domain",
    "domain_id": "xjtu",
    "dataset_id": "xjtu",
    "split_file": "UnifiedRawSOH/splits/xjtu/paper_v1_mixed_split.json",
    "batches": [
      "2C",
      "3C",
      "R2.5",
      "R3",
      "RW",
      "satellite"
    ],
    "label_rule": "bol_peak_mean_top5_first100_v1"
  },
  "output": {
    "paper_version": "Paper-v2",
    "experiment_id": "e1_single_domain",
    "model_id": "RawMamba-noCycleAux",
    "data_id": "xjtu"
  },
  "data": {
    "data_root": "UnifiedRawSOH/datasets/XJTU_raw",
    "domain_id": "xjtu",
    "dataset": "xjtu_raw_t_v1",
    "raw_len_cc": 128,
    "raw_len_cv": 256,
    "min_cc_points": 4,
    "min_cv_points": 4,
    "label_scale_mode": "auto_capacity_to_soh",
    "nominal_capacity": 2.0,
    "resampling": "linear",
    "use_tau": true,
    "use_real_time": true,
    "time_column": "relative_time_min",
    "time_unit": "minute",
    "time_origin": "charge_window_start",
    "use_temperature": true,
    "temperature_column": "temperature_C",
    "temperature_reference_c": 25.0,
    "temperature_scale_c": 20.0,
    "temperature_delta_origin": "charge_window_start",
    "temperature_delta_scale_c": 10.0,
    "use_t0_temperature_meta": true,
    "t0_temperature_reference_c": 25.0,
    "t0_temperature_scale_c": 20.0,
    "drop_incomplete_cycle": true,
    "data_mode": "all_batch_pooled",
    "num_workers": 0,
    "sample_filter_mode": "none",
    "balance_mode": "none",
    "use_train_derived_statistics": false,
    "label_mode": "bol_peak_relative",
    "label_field": "soh_bol",
    "bol_reference_rule": "bol_peak_mean_top5_first100_v1",
    "q_ref_is_model_input": false,
    "q_ref_in_normalization": false,
    "cycle_target_scope": "not_used"
  },
  "model": {
    "type": "PaperRawSOHModel",
    "variant": "base",
    "backend": "mamba_ssm.Mamba",
    "input_dim": 4,
    "d_model": 32,
    "num_layers": 3,
    "d_state": 8,
    "d_conv": 4,
    "expand": 2,
    "dt_rank": "auto",
    "dropout": 0.1,
    "pooling": "last_mean",
    "fusion_type": "concat",
    "fusion_phase_dim": 64,
    "head_hidden_dim": 128,
    "use_time_embedding": false,
    "use_time_as_input": true,
    "use_time_embedding_input_norm": true,
    "temperature_injection": "input_concat",
    "temperature_features": "delta",
    "use_t0_temperature_meta": true,
    "t0_temperature_injection": "post_fusion_concat",
    "t0_temperature_meta_dim": 1,
    "use_cc_to_cv_bridge": true,
    "cc_to_cv_bridge_type": "zero_init_linear",
    "cc_to_cv_bridge_input_dim": 64,
    "cc_to_cv_bridge_output_dim": 32,
    "use_cycle_prediction": false,
    "cycle_target": "cycle_life_norm",
    "use_predicted_cycle_for_soh": false,
    "detach_predicted_cycle_for_soh": false,
    "time_embedding_base": 10000.0,
    "time_embedding_time_scale_min": 10.0
  },
  "normalization": {
    "mode": "physical_window",
    "cc_voltage_low": 4.0,
    "cc_voltage_high": 4.195,
    "cv_current_low": 0.1,
    "cv_current_high": 0.5,
    "cc_current_ref": 4.0,
    "cv_voltage_ref": 4.19975,
    "cv_voltage_scale": 0.001,
    "cc_current_mode": "physical",
    "cv_voltage_mode": "physical",
    "current_use_abs": true,
    "temp_room": 25.0,
    "temp_abs_scale": 20.0,
    "temp_delta_scale": 10.0
  },
  "train": {
    "seed": 42,
    "device": "cuda",
    "batch_size": 64,
    "epochs": 500,
    "patience": 40,
    "lr": 0.001,
    "weight_decay": 0.0001,
    "grad_clip_norm": 1.0,
    "loss": "mse",
    "monitor": "valid_domain_macro_rmse",
    "cycle_loss_mode": "disabled",
    "lambda_cycle": 0.0,
    "cycle_loss_warmup_epochs": 1,
    "scheduler": {
      "type": "reduce_on_plateau",
      "mode": "min",
      "factor": 0.5,
      "patience": 10,
      "threshold": 1e-05,
      "min_lr": 1e-05
    }
  },
  "trainer": {
    "variant": "erm"
  },
  "eval": {
    "metrics": [
      "mape",
      "rmse"
    ],
    "aggregation": "physical_cell_macro_then_group_macro_then_domain_macro",
    "save_predictions": true,
    "save_per_cell_metrics": true,
    "save_per_group_metrics": true,
    "save_per_domain_metrics": true
  },
  "debug": {
    "debug_num_samples": 0,
    "deterministic": true
  }
}
