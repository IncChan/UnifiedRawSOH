{
  "status": "runnable",
  "experiment": {
    "name": "raw_mamba_xjtu_base",
    "version": "UnifiedRawSOH/Paper-v1",
    "task": "paper_raw_cc_cv_temperature_xjtu_mixed_all_batch",
    "domain_id": "xjtu",
    "dataset_id": "xjtu",
    "loader": "single_domain",
    "split_file": "UnifiedRawSOH/splits/xjtu/paper_v1_mixed_split.json",
    "output_root": "UnifiedRawSOH/outputs",
    "batches": ["2C", "3C", "R2.5", "R3", "RW", "satellite"]
  },
  "output": {
    "paper_version": "Paper-v1",
    "experiment_id": "e1_raw_soh_learning",
    "model_id": "RawMamba",
    "data_id": "xjtu"
  },
  "data": {
    "data_root": "UnifiedRawSOH/datasets/XJTU_raw",
    "domain_id": "xjtu",
    "dataset": "xjtu_raw_t_v1",
    "raw_len_cc": 128,
    "raw_len_cv": 256,
    "min_cc_points": 4,
    "min_cv_points": 4,
    "label_scale_mode": "auto_capacity_to_soh",
    "nominal_capacity": 2.0,
    "resampling": "linear",
    "use_tau": true,
    "use_real_time": true,
    "time_column": "relative_time_min",
    "time_unit": "minute",
    "time_origin": "charge_window_start",
    "use_temperature": true,
    "temperature_column": "temperature_C",
    "temperature_reference_c": 25.0,
    "temperature_scale_c": 20.0,
    "temperature_delta_origin": "charge_window_start",
    "temperature_delta_scale_c": 10.0,
    "use_t0_temperature_meta": true,
    "t0_temperature_reference_c": 25.0,
    "t0_temperature_scale_c": 20.0,
    "drop_incomplete_cycle": true,
    "data_mode": "all_batch_pooled",
    "num_workers": 0,
    "sample_filter_mode": "none",
    "raw_feature_pairing": "not_applied; XJTU_raw_t_v1 and XJTU_t_v1 do not map one-to-one for every condition",
    "batch_balanced_sampling": false,
    "balance_mode": "none",
    "use_train_derived_statistics": false,
    "cycle_target": "cycle_life_norm",
    "cycle_target_scope": "training_loss_only_full_life_coordinate; validation_test_diagnostic_only; never an inference input"
  },
  "model": {
    "type": "PaperRawSOHModel",
    "backend": "mamba_ssm.Mamba",
    "input_dim": 4,
    "d_model": 32,
    "num_layers": 3,
    "d_state": 8,
    "d_conv": 4,
    "expand": 2,
    "dt_rank": "auto",
    "dropout": 0.1,
    "pooling": "last_mean",
    "fusion_type": "concat",
    "fusion_phase_dim": 64,
    "head_hidden_dim": 128,
    "use_time_embedding": false,
    "use_time_as_input": true,
    "use_time_embedding_input_norm": true,
    "temperature_injection": "input_concat",
    "temperature_features": "delta",
    "use_t0_temperature_meta": true,
    "t0_temperature_injection": "post_fusion_concat",
    "t0_temperature_meta_dim": 1,
    "use_cc_to_cv_bridge": true,
    "cc_to_cv_bridge_type": "zero_init_linear",
    "cc_to_cv_bridge_input_dim": 64,
    "cc_to_cv_bridge_output_dim": 32,
    "use_cycle_prediction": true,
    "cycle_target": "cycle_life_norm",
    "cycle_head_hidden_dim": 64,
    "cycle_output_activation": "sigmoid",
    "use_predicted_cycle_for_soh": true,
    "detach_predicted_cycle_for_soh": false,
    "cycle_injection_position": "prediction_head_first_hidden",
    "cycle_adapter_type": "zero_init_linear",
    "cycle_adapter_input_dim": 1,
    "cycle_adapter_output_dim": 128,
    "time_embedding_base": 10000.0,
    "time_embedding_time_scale_min": 10.0
  },
  "normalization": {
    "mode": "physical_window",
    "cc_voltage_low": 4.0,
    "cc_voltage_high": 4.195,
    "cv_current_low": 0.1,
    "cv_current_high": 0.5,
    "cc_current_ref": 4.0,
    "cv_voltage_ref": 4.19975,
    "cv_voltage_scale": 0.001,
    "cc_current_mode": "physical",
    "cv_voltage_mode": "physical",
    "current_use_abs": true,
    "temp_room": 25.0,
    "temp_abs_scale": 20.0,
    "temp_delta_scale": 10.0
  },
  "train": {
    "seed": 42,
    "device": "cuda",
    "batch_size": 64,
    "epochs": 500,
    "patience": 40,
    "lr": 0.001,
    "weight_decay": 0.0001,
    "grad_clip_norm": 1.0,
    "loss": "mse",
    "monitor": "valid_condition_macro_rmse",
    "cycle_loss_mode": "supervised",
    "lambda_cycle": 0.0035,
    "cycle_loss_warmup_epochs": 10,
    "scheduler": {
      "type": "reduce_on_plateau",
      "mode": "min",
      "factor": 0.5,
      "patience": 10,
      "threshold": 1e-5,
      "min_lr": 1e-5
    }
  },
  "eval": {
    "metrics": ["mae", "mape", "mse", "rmse"],
    "aggregation": "condition_macro_for_selection_with_battery_diagnostics",
    "save_predictions": true,
    "save_per_battery_metrics": true,
    "save_per_condition_metrics": true
  },
  "debug": {
    "debug_num_samples": 0,
    "deterministic": true
  }
}
