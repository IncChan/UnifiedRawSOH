# Python / editor state
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.vscode/

# Local raw/feature products. They remain available beside the code for
# training, but are deliberately not versioned or redistributed through Git.
datasets/XJTU_raw/**
datasets/XJTU_features/**
datasets/MIT_raw/**
datasets/MIT_features/**
datasets/SmartHealth_raw/**
datasets/SmartHealth_features/**
datasets/PaperBackup_preprocessed/**
datasets/PaperBackup_preprocessed_v2/**
datasets/PaperBackup_preprocessed_v2_128x128/**
datasets/PaperBackup_preprocessed_v2_e2_final/**
datasets/_legacy_aligned/

# Generated experiment artifacts stay local: checkpoints, per-cycle
# predictions, logs, copied configs, and full histories do not belong in Git.
# Publish only deliberate paper-level summaries under results/.
outputs/**
!outputs/.gitkeep

# Local machine-specific preprocessing locations. Copy the tracked example
# before setting source and output directories.
preprocess/paths.env

# Common local artifacts
*.log
*.tmp
*.swp
