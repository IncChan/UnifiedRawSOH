# Copy this file to preprocess/paths.env and replace all source locations.
# The launcher exports REPO_ROOT before it reads this file.

# Use an environment with numpy, scipy, h5py, and matplotlib installed.
PYTHON_BIN="python"

# Immutable source archives.  These directories are never copied into Git.
XJTU_SOURCE_ROOT="/absolute/path/to/XJTU battery dataset"
MIT_SOURCE_ROOT="/absolute/path/to/A123 Dataset"
SMARTHEALTH_SOURCE_ROOT="/absolute/path/to/SmartHealth"

# Canonical local products consumed by UnifiedRawSOH training.  They are all
# ignored by Git by design.  External output locations are also valid.
XJTU_RAW_OUTPUT="${REPO_ROOT}/datasets/XJTU_raw"
XJTU_FEATURE_OUTPUT="${REPO_ROOT}/datasets/XJTU_features"
MIT_RAW_OUTPUT="${REPO_ROOT}/datasets/MIT_raw"
MIT_FEATURE_OUTPUT="${REPO_ROOT}/datasets/MIT_features"
SMARTHEALTH_RAW_OUTPUT="${REPO_ROOT}/datasets/SmartHealth_raw"
SMARTHEALTH_FEATURE_OUTPUT="${REPO_ROOT}/datasets/SmartHealth_features"

# Versioned split specifications remain in the repository unless an external
# destination is deliberately required.
MIT_SPLIT_OUTPUT="${REPO_ROOT}/splits/mit/mit_paper_physical124_v2_split.json"
SMARTHEALTH_SPLITS_OUTPUT="${REPO_ROOT}/splits/smarthealth"

# The launcher passes this value to extractors that support parallelism.
# Start conservatively and increase only while RAM and storage I/O allow it.
PREPROCESS_WORKERS=4
